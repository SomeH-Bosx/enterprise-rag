OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
VECTOR_DB_PATH=./chroma_db
UPLOAD_CACHE_DIR=./upload_cache
BM25_STORE_PATH=./chroma_db/bm25_store.json
DOC_REGISTRY_PATH=./chroma_db/doc_registry.json
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
RECALL_TOP_N=20
# Default serving config (Phase5): Hybrid@20 candidates → Reranker Top-5 → LLM generation
USE_BM25=true
# dense | bm25 | hybrid — leave empty to derive from USE_BM25 (true→hybrid, else dense)
RETRIEVAL_MODE=hybrid
USE_RERANKER=true
USE_PDR=false
USE_QUERY_ROUTER=true
QUERY_ROUTER_MODE=rules_llm
USE_QUERY_REWRITE=true
QUERY_REWRITE_MODE=rules_llm
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BACKEND=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
LLM_TEMPERATURE=0.1
COLLECTION_NAME=enterprise_rag
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
USE_CONVERSATION_MEMORY=true
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=3000
CONVERSATION_STORE_PATH=./chroma_db/conversations.json
ENABLE_TABLE_SERIALIZATION=true
ENABLE_OCR=true
OCR_LANG=chi_sim+eng
OCR_MIN_TEXT_CHARS=40
OCR_DPI=200
